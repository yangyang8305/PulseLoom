// Non-secret project defaults. Override in ignored Config/Local.xcconfig.
APP_BUNDLE_ID = com.yoyo.PulseLoom
APP_GROUP_ID = group.com.yoyo.PulseLoom
CLOUD_CONTAINER_ID = iCloud.com.yoyo.PulseLoom
PRO_PRODUCT_ID = com.yoyo.PulseLoom.pro.lifetime
RELAY_BASE_URL =
SUPPORT_URL =
DEVELOPMENT_TEAM =
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_BITCODE = NO
GCC_C_LANGUAGE_STANDARD = gnu17
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
#include? "Local.xcconfig"
